ROUTINE OMINV
OMINV ;ACME/JRB - INVOICING ;07/20/1998
 ;;1.0;OMS;**10,16**;Mar 12, 1998
 ;
 ; ^INVC(INV) = ORDER ^ CUSTOMER ^ INVOICE DATE ^ AMOUNT ^ DUE DATE ^ PAID ^ STATUS (O/P)
 ; ^INVC(INV,"P",N) = DATE ^ AMOUNT ^ METHOD
 Q
 ;
INV ; invoice a shipped order
 ; in:  ORD
 ; out: INV, or ERR
 N X,TERMS
 K ERR S U="^"
 S X=$G(^SORD(+$G(ORD))) I $P(X,U,3)'="S" S ERR="ONLY SHIPPED ORDERS CAN BE INVOICED" Q
 S TERMS=$G(^OMCTL("PARM","TERMS"),30)
 S INV=$$NXT^OMUTL("INVC")
 S ^INVC(INV)=ORD_U_$P(X,U)_U_(+$H)_U_$P(X,U,4)_U_(+$H+TERMS)_U_0_U_"O"
 S ^INVCX("C",$P(X,U),INV)="",^INVCX("O",INV)=""
 S $P(^SORD(ORD),U,3)="I",$P(^(ORD),U,5)=INV
 K ^SORDX("S","S",ORD) S ^SORDX("S","I",ORD)=""
 D AUD^OMUTL("INV-NEW",INV)
 Q
