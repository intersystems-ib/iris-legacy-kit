    "mcp__plugin_iris-legacy_iris__compare_namespace",
    "mcp__plugin_iris-legacy_iris__docs_introspect",
    "mcp__plugin_iris-legacy_iris__iris_doc_search",
    "mcp__plugin_iris-legacy_iris__iris_get_log",
    "mcp__plugin_iris-legacy_iris__iris_info",
    "mcp__plugin_iris-legacy_iris__iris_macro",
    "mcp__plugin_iris-legacy_iris__iris_search",
    "mcp__plugin_iris-legacy_iris__iris_symbols",
    "mcp__plugin_iris-legacy_iris__iris_symbols_local",
    "mcp__plugin_iris-legacy_iris__iris_test",
    "Bash(scripts/test.sh:*)",
    "Bash(scripts/check.sh:*)",
    "Bash(git status:*)",
    "Bash(git diff:*)",
    "Bash(git log:*)"
