# Copy to .env (scripts/up.sh does it on the first run). Written by /iris-legacy:bootstrap.

# ---------- Edition ---------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml
IRIS_IMAGE=containers.intersystems.com/intersystems/iris-community:__IRIS_TAG__
# Licensed (needs ./iris.key, gitignored):
#COMPOSE_FILE=docker-compose.yml:docker-compose.licensed.yml
#IRIS_IMAGE=containers.intersystems.com/intersystems/iris:__IRIS_TAG__

WEBGATEWAY_TAG=__IRIS_TAG__

# ---------- Ports: keep WEBGATEWAY_HTTP_PORT in step with web_port in .iris-agentic-dev.toml ------
WEBGATEWAY_HTTP_PORT=__WEB_PORT__
IRIS_SUPERSERVER_PORT=__SS_PORT__

# ---------- Dev-only settings used by scripts/ (must match docker/webgateway/CSP.ini) ----------
IRIS_NAMESPACE=__NS__
IRIS_CONTAINER=__NAME__-iris
